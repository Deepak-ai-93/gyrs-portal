# GYRS Career Assistant - AI Configuration
# These values can be overridden per-environment

# Supabase PostgreSQL (set DB_URL in your local .env before deploying migrations)
# DB_CONNECTION=pgsql
# DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# ---------------------------------------------------------------------------
# SMS OTP — Twilio Programmable Messaging
# ---------------------------------------------------------------------------
# SMS_DRIVER=twilio sends real SMS. Use SMS_DRIVER=log only for local
# development: the message is written to the application log instead.
SMS_DRIVER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Use either a sender number (E.164, e.g. +12025550123) or a Messaging Service.
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_TIMEOUT=10

# OTP policy (optional overrides)
OTP_CODE_LENGTH=6
OTP_TTL_MINUTES=10
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_PER_HOUR=5
OTP_VERIFY_PER_TEN_MINUTES=10

# Enable/disable AI analysis feature
AI_ENABLED=true

# AI Provider: gemini, openai, or openrouter
AI_PROVIDER=gemini

# API key for the selected provider (required when AI_ENABLED=true)
AI_API_KEY=

# Model name for the selected provider
AI_MODEL=gemini-3.1-flash-lite

# Custom base URL for OpenAI-compatible gateways (leave blank for defaults)
AI_BASE_URL=

# Request timeout in seconds
AI_TIMEOUT=30

# Maximum input characters from résumé (truncated if exceeded)
AI_MAX_INPUT_CHARS=16000

# Maximum generated tokens per résumé analysis (keeps API usage bounded)
AI_MAX_OUTPUT_TOKENS=1200

# Maximum file size in KB for uploads
AI_MAX_FILE_KB=3072

# Daily analysis limit per user
AI_DAILY_LIMIT=3

# Monthly analysis limit per user
AI_MONTHLY_LIMIT=15

# Monthly budget cap in USD
AI_MONTHLY_BUDGET_USD=20

# USD per million input tokens. Keep aligned with your provider, model and tier.
AI_INPUT_COST_PER_MILLION=0.25

# USD per million output tokens. These defaults use Gemini 3.1 Flash-Lite standard paid rates.
AI_OUTPUT_COST_PER_MILLION=1.5

# Retention period for analysis data in days
AI_RETENTION_DAYS=180

# Prompt version for AI analysis
PROMPT_VERSION=resume-v1

# Consent version (date format YYYY-MM)
CONSENT_VERSION=2026-10
