APP_NAME="GYRS Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# GYRS application settings.
# Password assigned to seeded development accounts (local/development only).
GYRS_DEV_PASSWORD=
GYRS_ADMIN_EMAIL=admin.gyrs@gujarat.gov.in

# Local development uses SQLite; production uses Supabase Postgres.
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_HOST=
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres
# DB_PASSWORD=
# DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@gyrs.gujarat.gov.in"
MAIL_FROM_NAME="${APP_NAME}"

# Supabase (server-side only; never expose SUPABASE_SERVICE_ROLE_KEY to the browser)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=job-notifications

VITE_APP_NAME="${APP_NAME}"
